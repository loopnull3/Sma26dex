     public native ParcelFileDescriptor getXConnection();
     public native ParcelFileDescriptor getLogcatOutput();
     public native void reportFatalError(String message);
+
+    /**
+     * Sma26dex: called by a "-tag" window when the user closes it.
+     * Runs $TERMUX_X11_WINDOW_CLOSED_CMD (set by whoever started this X server) so the
+     * program shown in the window can be asked to close, like a desktop window manager would.
+     */
+    @Override
+    public void windowClosed() {
+        System.err.println("termux-x11: window closed by user");
+        String cmd = System.getenv("TERMUX_X11_WINDOW_CLOSED_CMD");
+        if (cmd == null || cmd.isEmpty())
+            return;
+        try {
+            new ProcessBuilder("/system/bin/sh", "-c", cmd).redirectErrorStream(true).start();
+        } catch (Exception e) {
+            android.util.Log.e("CmdEntryPoint", "TERMUX_X11_WINDOW_CLOSED_CMD failed", e);
+        }
+    }
     @CriticalNative private static native boolean connected();
 
     static {
