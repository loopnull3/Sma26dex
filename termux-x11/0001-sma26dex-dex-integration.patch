         handler.removeCallbacks(serverWatchdog);
         if (mInputHandler != null)
diff --git a/lorie/src/main/java/com/termux/x11/WindowsFileActivity.java b/lorie/src/main/java/com/termux/x11/WindowsFileActivity.java
new file mode 100644
index 0000000..2c63aa0
--- /dev/null
+++ b/lorie/src/main/java/com/termux/x11/WindowsFileActivity.java
@@ -0,0 +1,185 @@
+package com.termux.x11;
+
+import android.app.Activity;
+import android.content.Intent;
+import android.database.Cursor;
+import android.net.Uri;
+import android.os.Build;
+import android.os.Bundle;
+import android.provider.DocumentsContract;
+import android.provider.OpenableColumns;
+import android.text.TextUtils;
+import android.util.Log;
+import android.widget.Toast;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * Sma26dex: lets file managers (e.g. Samsung My Files) open Windows programs.
+ * The file is handed to Termux as "s26dex open <path>" through Termux's RUN_COMMAND service,
+ * which decides how to run it (installers in the Wine desktop, other programs in their own window).
+ * The RUN_COMMAND permission is granted automatically to the sharedUid build because it shares
+ * Termux's user id; Termux also needs "allow-external-apps = true" in ~/.termux/termux.properties.
+ */
+public class WindowsFileActivity extends Activity {
+    private static final String TAG = "WindowsFileActivity";
+    private static final String TERMUX_PACKAGE = "com.termux";
+    private static final String TERMUX_PREFIX = "/data/data/com.termux/files/usr";
+    private static final String TERMUX_HOME = "/data/data/com.termux/files/home";
+    private static final String[] EXTENSIONS = {".exe", ".msi", ".bat", ".cmd", ".lnk", ".com"};
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        try {
+            launch(getIntent());
+        } catch (Exception e) {
+            Log.e(TAG, "Can not open Windows program", e);
+            Toast.makeText(this, e.getMessage(), Toast.LENGTH_LONG).show();
+        }
+        finish();
+    }
+
+    @SuppressWarnings("deprecation")
+    private void launch(Intent intent) throws Exception {
+        Uri uri = intent == null ? null : intent.getData();
+        if (uri == null && intent != null && Intent.ACTION_SEND.equals(intent.getAction()))
+            uri = intent.getParcelableExtra(Intent.EXTRA_STREAM);
+        if (uri == null)
+            throw new Exception(getString(R.string.s26_no_file));
+
+        String name = displayName(uri);
+        if (!isWindowsProgram(name))
+            throw new Exception(getString(R.string.s26_not_windows_program, name));
+
+        String path = readablePath(uri, name);
+        if (path == null)
+            path = copyIntoTermux(uri, name);
+
+        startTermux(path, name);
+        Toast.makeText(this, getString(R.string.s26_starting, name), Toast.LENGTH_SHORT).show();
+    }
+
+    private static boolean isWindowsProgram(String name) {
+        String lower = name == null ? "" : name.toLowerCase(Locale.ROOT);
+        for (String ext : EXTENSIONS)
+            if (lower.endsWith(ext))
+                return true;
+        return false;
+    }
+
+    private String displayName(Uri uri) {
+        if ("content".equals(uri.getScheme())) {
+            try (Cursor c = getContentResolver().query(uri, new String[]{OpenableColumns.DISPLAY_NAME}, null, null, null)) {
+                if (c != null && c.moveToFirst() && !c.isNull(0))
+                    return c.getString(0);
+            } catch (Exception e) {
+                Log.w(TAG, "DISPLAY_NAME query failed", e);
+            }
+        }
+        String last = uri.getLastPathSegment();
+        if (last != null && last.contains("/"))
+            last = last.substring(last.lastIndexOf('/') + 1);
+        if (last != null && last.contains(":"))
+            last = last.substring(last.lastIndexOf(':') + 1);
+        return last == null ? "program.exe" : last;
+    }
+
+    /**
+     * Real file path for the uri when Termux can read it directly. Running the program from its own
+     * folder matters: most programs load DLLs and data files that sit next to the .exe.
+     */
+    private String readablePath(Uri uri, String name) {
+        if ("file".equals(uri.getScheme()))
+            return readable(uri.getPath());
+
+        // Many providers (including media and file manager providers) still expose the "_data" column.
+        try (Cursor c = getContentResolver().query(uri, new String[]{"_data"}, null, null, null)) {
+            if (c != null && c.moveToFirst() && !c.isNull(0)) {
+                String p = readable(c.getString(0));
+                if (p != null)
+                    return p;
+            }
+        } catch (Exception ignored) {}
+
+        // Storage Access Framework: content://com.android.externalstorage.documents/document/primary:Download/x.exe
+        try {
+            if (DocumentsContract.isDocumentUri(this, uri)
+                    && "com.android.externalstorage.documents".equals(uri.getAuthority())) {
+                String[] parts = DocumentsContract.getDocumentId(uri).split(":", 2);
+                String root = "primary".equalsIgnoreCase(parts[0]) ? "/storage/emulated/0" : "/storage/" + parts[0];
+                String p = readable(root + "/" + (parts.length > 1 ? parts[1] : ""));
+                if (p != null)
+                    return p;
+            }
+        } catch (Exception ignored) {}
+
+        // File manager providers usually embed the storage path in the uri, e.g.
+        // content://<provider>/device_storage/0/Download/x.exe or .../storage/emulated/0/Download/x.exe
+        List<String> seg = uri.getPathSegments();
+        for (int i = 0; i < seg.size(); i++) {
+            String rest = TextUtils.join("/", seg.subList(i, seg.size()));
+            if (!rest.endsWith(name))
+                continue;
+            for (String root : new String[]{"/storage/emulated/0/", "/storage/", "/"}) {
+                String p = readable(root + rest);
+                if (p != null)
+                    return p;
+            }
+        }
+        return null;
+    }
+
+    private static String readable(String path) {
+        if (path == null || path.isEmpty())
+            return null;
+        File f = new File(path);
+        return f.isFile() && f.canRead() ? f.getAbsolutePath() : null;
+    }
+
+    /** Fallback: copy the program into Termux's home (works for single-file installers). */
+    private String copyIntoTermux(Uri uri, String name) throws Exception {
+        File dir = new File(TERMUX_HOME, "Downloads/Windows");
+        File out = new File(dir, name.replace('/', '_'));
+        try {
+            if (!dir.isDirectory() && !dir.mkdirs())
+                throw new Exception("mkdir " + dir);
+            try (InputStream in = getContentResolver().openInputStream(uri);
+                 OutputStream os = new FileOutputStream(out)) {
+                if (in == null)
+                    throw new Exception("openInputStream");
+                byte[] buf = new byte[1 << 16];
+                int n;
+                while ((n = in.read(buf)) > 0)
+                    os.write(buf, 0, n);
+            }
+            return out.getAbsolutePath();
+        } catch (Exception e) {
+            Log.w(TAG, "copy failed", e);
+            throw new Exception(getString(R.string.s26_copy_failed, name));
+        }
+    }
+
+    private void startTermux(String path, String name) throws Exception {
+        Intent i = new Intent("com.termux.RUN_COMMAND");
+        i.setClassName(TERMUX_PACKAGE, "com.termux.app.RunCommandService");
+        i.putExtra("com.termux.RUN_COMMAND_PATH", TERMUX_PREFIX + "/bin/s26dex");
+        i.putExtra("com.termux.RUN_COMMAND_ARGUMENTS", new String[]{"open", path});
+        i.putExtra("com.termux.RUN_COMMAND_WORKDIR", TERMUX_HOME);
+        i.putExtra("com.termux.RUN_COMMAND_BACKGROUND", true);
+        i.putExtra("com.termux.RUN_COMMAND_COMMAND_LABEL", "s26dex open " + name);
+        try {
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O)
+                startForegroundService(i);
+            else
+                startService(i);
+        } catch (Exception e) {
+            throw new Exception(getString(R.string.s26_termux_failed, e.getMessage()));
+        }
+    }
+}
