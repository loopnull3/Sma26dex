+    /** Sma26dex: applies EXTRA_TASK_LABEL / EXTRA_TASK_ICON(_B64) from an intent to this window's task. */
+    @SuppressWarnings("deprecation")
+    void applyTaskDescription(Intent intent) {
+        if (intent == null)
+            return;
+        String label = intent.getStringExtra(EXTRA_TASK_LABEL);
+        Bitmap icon = decodeTaskIcon(intent);
+        if ((label == null || label.isEmpty()) && icon == null)
+            return;
+        if (label != null && !label.isEmpty()) {
+            taskLabel = label;
+            setTitle(label);
+        }
+        if (icon != null)
+            taskIcon = icon;
+        try {
+            setTaskDescription(new ActivityManager.TaskDescription(taskLabel, taskIcon));
+        } catch (Exception e) {
+            Log.w("MainActivity", "setTaskDescription failed", e);
+        }
+    }
+
+    private static Bitmap decodeTaskIcon(Intent intent) {
+        try {
+            String b64 = intent.getStringExtra(EXTRA_TASK_ICON_B64);
+            if (b64 != null && !b64.isEmpty()) {
+                byte[] data = Base64.decode(b64, Base64.DEFAULT);
+                return BitmapFactory.decodeByteArray(data, 0, data.length);
+            }
+            String path = intent.getStringExtra(EXTRA_TASK_ICON);
+            if (path != null && !path.isEmpty())
+                return BitmapFactory.decodeFile(path);
+        } catch (Throwable t) {
+            Log.w("MainActivity", "Can not decode task icon", t);
+        }
+        return null;
     }
 
     @Override
     protected void onDestroy() {
