#!/usr/bin/env bash
# s26dex — Galaxy S26 + Samsung DeX 에서 Windows 앱을 고성능으로 실행
# 구성: Termux(네이티브) + Termux:X11 + Hangover(Wine 11 + FEX/Box64) + DXVK/VKD3D-Proton
set -o pipefail

_self="$(readlink -f "${BASH_SOURCE[0]}")"
S26_ROOT="$(cd "$(dirname "$_self")/.." && pwd)"
# shellcheck source=../lib/common.sh
. "$S26_ROOT/lib/common.sh"
# shellcheck source=../lib/dexwin.sh
. "$S26_ROOT/lib/dexwin.sh"

usage() {
  cat <<'EOF'
사용법: s26dex <명령> [옵션]

  run     [옵션] <파일.exe|.msi|.bat|.lnk> [인자...]
          기본: 앱마다 독립된 DeX 창으로 실행 (DeX 작업표시줄·Alt+Tab·창 크기 조절)
            --dex                 DeX 창 모드 (기본)
            --label <이름>        DeX 창/작업표시줄에 보일 이름 (기본: exe 이름)
            --desktop             Wine 데스크톱(시작 메뉴/작업표시줄) 안에서 실행 — 설치 프로그램 기본값
            -p, --profile compat|balanced|performance|extreme  (기본: performance)
            --emu32 box64|fex     32비트 x86 에뮬레이터 (기본 box64)
            --cores all|big|prime|0-7   CPU 코어 고정 (기본: 프로필 값)
            --fps N               프레임 제한 (발열 억제 → 지속 성능↑)
            --d3d dxvk|wined3d    Direct3D 백엔드 (기본 dxvk)
            --gl zink|llvmpipe    OpenGL 백엔드
            --hud | --mangohud    FPS/프레임타임 오버레이
            --no-desktop          (--desktop 모드에서) 가상 데스크톱 밖에서 실행
            --log                 Wine 로그를 파일로 저장
            --dry-run             실행 없이 환경/명령만 출력
  app     add <이름> [run옵션] <exe>   DeX 바탕화면/위젯용 바로가기 + exe 아이콘
          ls | rm <이름> | reset <이름>     목록 / 삭제 / 앱 레지스트리를 메인에서 다시 복사
  ps                     DeX 창으로 실행 중인 앱
  show    <앱>           닫았던(숨긴) DeX 창 다시 열기
  close   [--force] <앱> 앱에 닫기 요청 (저장 확인이 뜨면 창을 앞으로). --force 는 즉시 종료
  start   [--game] [--render PCT | --res WxH | --native] [--fullscreen]
          [--shell desktop|openbox|none]
          Windows 데스크톱 모드: 시작 메뉴·작업표시줄이 있는 Wine 데스크톱을 DeX 창 하나에
            --game        게임 모드: 전체화면, 마우스 캡처, 스캔코드, 메타키 캡처
            --render 75   네이티브 해상도의 75%로 렌더 후 확대 (GPU 부하↓)
            --res 1600x900  고정 해상도
  open    <파일>         내 파일 등에서 연 exe/msi 실행 (패치판 Termux:X11 이 호출, 로그는 ~/.cache/sma26dex/logs)
  info    <exe>          실행 파일 아키텍처(x64/x86/ARM64) 확인
  fonts                  한글 글꼴 대체(맑은 고딕·굴림 등 → Noto Sans CJK KR) 다시 적용
  locale  ko|off         한국어 Windows(코드페이지 949, 한국어 메뉴) 켜기/끄기 [실험적]
  dxvk    install|deploy|status   DXVK + VKD3D-Proton 설치/적용
  detect                 GPU/Vulkan 드라이버/CPU 클러스터 재탐지
  doctor                 성능 저하 원인 점검 (cpuset, 드라이버, 설정)
  vkdebug                Vulkan 드라이버 진단 (~/s26dex-vkdebug.txt 에 저장)
  status                 실행 중인 Wine 프로세스와 사용 코어
  dpi     <96-288>       Wine 글꼴/UI 배율
  cfg                    winecfg 실행
  wine    <인자...>       환경이 적용된 wine 직접 실행 (예: s26dex wine taskmgr)
  kill                   Wine 프로세스 전부 종료 (DeX 창 앱 포함)
  stop                   Wine + X 서버 + 오디오 종료
EOF
}

# ------------------------------------------------------------------ helpers
x11_pref() {
  have termux-x11-preference || { warn "termux-x11-preference 없음 (termux-x11-nightly 패키지 확인)"; return 0; }
  timeout 10 termux-x11-preference "$@" >/dev/null 2>&1 ||
    warn "Termux:X11 설정 적용 실패 (앱이 열려 있어야 함): $*"
}

start_audio() {
  have pulseaudio || return 0
  pulseaudio --check >/dev/null 2>&1 && return 0
  pulseaudio --start --exit-idle-time=-1 >/dev/null 2>&1 || warn "PulseAudio 시작 실패 (소리 없음)"
}

wine_reg() { "$(wine_bin)" reg add "$@" /f >/dev/null 2>&1; }

dxvk_dir()  { echo "$S26_CACHE_DIR/dl/dxvk-$DXVK_VERSION"; }
vkd3d_dir() { echo "$S26_CACHE_DIR/dl/vkd3d-proton-$VKD3D_VERSION"; }
sys32()     { echo "$S26_WINEPREFIX/drive_c/windows/system32"; }
syswow()    { echo "$S26_WINEPREFIX/drive_c/windows/syswow64"; }
dxvk_deployed()  { grep -qa 'dxvk' "$(sys32)/d3d11.dll" 2>/dev/null; }
vkd3d_deployed() { grep -qai 'vkd3d' "$(sys32)/d3d12core.dll" 2>/dev/null; }

fetch() { # url dest
  [ -s "$2" ] && return 0
  info "다운로드: $1"
  if have curl; then curl -fL --retry 3 -o "$2.part" "$1"
  else wget -O "$2.part" "$1"; fi && mv "$2.part" "$2"
}

dxvk_download() {
  local dl="$S26_CACHE_DIR/dl"; mkdir -p "$dl"
  local dz="$dl/dxvk-$DXVK_VERSION.tar.gz" vz="$dl/vkd3d-proton-$VKD3D_VERSION.tar.zst"
  fetch "https://github.com/doitsujin/dxvk/releases/download/v$DXVK_VERSION/dxvk-$DXVK_VERSION.tar.gz" "$dz" ||
    die "DXVK 다운로드 실패"
  [ -d "$(dxvk_dir)" ] || tar -xzf "$dz" -C "$dl" || die "DXVK 압축 해제 실패"
  ok "DXVK $DXVK_VERSION 준비됨"
  if fetch "https://github.com/HansKristian-Work/vkd3d-proton/releases/download/v$VKD3D_VERSION/vkd3d-proton-$VKD3D_VERSION.tar.zst" "$vz"; then
    if [ ! -d "$(vkd3d_dir)" ] && ! { zstd -dc "$vz" | tar -x -C "$dl"; }; then
      rm -rf "$(vkd3d_dir)"
      warn "VKD3D-Proton 압축 해제 실패 (pkg install zstd) — D3D12 는 Wine 내장 vkd3d 사용"
      return 0
    fi
    ok "VKD3D-Proton $VKD3D_VERSION 준비됨"
  else
    warn "VKD3D-Proton 다운로드 실패 — D3D12 는 Wine 내장 vkd3d 사용"
  fi
}

dxvk_deploy() {
  [ -d "$S26_WINEPREFIX/drive_c/windows" ] || { warn "Wine 프리픽스가 아직 없음 — s26dex start 시 자동 적용"; return 0; }
  [ -d "$(dxvk_dir)" ] || dxvk_download
  local d v
  d="$(dxvk_dir)"; v="$(vkd3d_dir)"
  cp -f "$d"/x64/*.dll "$(sys32)/" && cp -f "$d"/x32/*.dll "$(syswow)/" || die "DXVK 복사 실패"
  if [ -d "$v" ]; then
    local x86="$v/x86"; [ -d "$x86" ] || x86="$v/x32"
    cp -f "$v"/x64/d3d12*.dll "$(sys32)/" 2>/dev/null
    cp -f "$x86"/d3d12*.dll "$(syswow)/" 2>/dev/null
  fi
  ok "DXVK 적용: system32(x64) / syswow64(x86)  — 오버라이드는 run 시 x86/x64 앱에만 적용"
}

ensure_prefix() {
  if [ ! -f "$S26_WINEPREFIX/system.reg" ]; then
    info "Wine 프리픽스 생성: $S26_WINEPREFIX (최초 1회, 1~3분)"
    ( wine_base_env; WINEDLLOVERRIDES="mscoree=;mshtml=" "$(wine_bin)" wineboot -i ) \
      >"$S26_LOG_DIR/wineboot.log" 2>&1 || warn "wineboot 경고 — $S26_LOG_DIR/wineboot.log 확인"
    ( wine_base_env; "$(wineserver_bin)" -w )
    ( wine_base_env
      # 게임 전체화면 시 마우스가 창 밖으로 나가지 않게
      wine_reg 'HKCU\Software\Wine\X11 Driver' /v GrabFullscreen /t REG_SZ /d Y
      apply_korean_fonts )
    ok "프리픽스 생성 완료"
  fi
  if ! dxvk_deployed && [ -d "$(dxvk_dir)" ]; then dxvk_deploy; fi
}

wait_x11() {
  local _
  for _ in $(seq 1 40); do x11_running && return 0; sleep 0.5; done
  return 1
}

# ------------------------------------------------------------------ commands
cmd_detect() { require_termux; detect_device; }

cmd_start() {
  local game=0 render="" res="" native=0 fs="" shell="${S26_SHELL:-desktop}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --game) game=1 ;;
      --render) render="$2"; shift ;;
      --res) res="$2"; shift ;;
      --native) native=1 ;;
      --fullscreen) fs=true ;;
      --shell) shell="$2"; shift ;;
      *) die "start: 알 수 없는 옵션 $1" ;;
    esac; shift
  done
  require_termux; mkdirs; load_device

  have termux-wake-lock && termux-wake-lock >/dev/null 2>&1 &
  /system/bin/pm path com.termux.x11 >/dev/null 2>&1 ||
    warn "Termux:X11 앱이 설치되지 않은 것 같습니다 (docs/ANDROID-SETUP.md)."
  start_audio

  if ! x11_running; then
    info "Termux:X11 서버 시작 ($S26_DISPLAY)"
    # shellcheck disable=SC2086
    nohup termux-x11 "$S26_DISPLAY" $S26_X11_ARGS >"$S26_LOG_DIR/x11.log" 2>&1 &
  fi
  am start --user 0 -n com.termux.x11/com.termux.x11.MainActivity >/dev/null 2>&1
  wait_x11 || die "X 서버 응답 없음 — $S26_LOG_DIR/x11.log 확인 (검은 화면이면 S26_X11_ARGS=-legacy-drawing)"

  # Termux:X11 설정 (DeX 에는 물리 키보드/마우스가 있으므로 보조 키바·IME 숨김)
  local p=(showAdditionalKbd:false showIMEWhileExternalConnected:false)
  if [ "$game" = 1 ]; then
    p+=(pointerCapture:true preferScancodes:true dexMetaKeyCapture:true screenIdleTimeout:never)
    fs="${fs:-true}"
  else
    p+=(pointerCapture:false dexMetaKeyCapture:false)
  fi
  [ -n "$fs" ] && p+=("fullscreen:$fs")
  if [ -n "$render" ]; then
    [[ "$render" =~ ^[0-9]+$ ]] && [ "$render" -ge 34 ] && [ "$render" -le 300 ] || die "--render 는 34~300(%)"
    p+=(displayResolutionMode:scaled "displayScale:$((10000 / render))" displayFilteringMode:bilinear)
  elif [ -n "$res" ]; then
    [[ "$res" =~ ^[0-9]+x[0-9]+$ ]] || die "--res 형식: 1920x1080"
    p+=(displayResolutionMode:custom "displayResolutionCustom:$res")
  elif [ "$native" = 1 ]; then
    p+=(displayResolutionMode:native)
  fi
  x11_pref "${p[@]}"
  sleep 1

  ensure_prefix
  local size; size="$(x11_size)"; size="${size:-1920x1080}"
  ok "X 화면: $size  |  GPU: ${S26_VK_DEVICE:-?}"

  case "$shell" in
    desktop)
      ( wine_base_env
        if [ -n "${S26_CPUS_ALL:-}" ] && have taskset; then
          nohup taskset -c "$S26_CPUS_ALL" "$(wine_bin)" explorer "/desktop=$S26_DESKTOP_NAME,$size" >"$S26_LOG_DIR/desktop.log" 2>&1 &
        else
          nohup "$(wine_bin)" explorer "/desktop=$S26_DESKTOP_NAME,$size" >"$S26_LOG_DIR/desktop.log" 2>&1 &
        fi )
      ok "Wine 데스크톱 실행 (작업표시줄/시작메뉴). 앱 실행: s26dex run <exe>" ;;
    openbox)
      have openbox || die "openbox 미설치: pkg install openbox"
      DISPLAY="$S26_DISPLAY" nohup openbox-session >"$S26_LOG_DIR/openbox.log" 2>&1 &
      ok "openbox 실행. 앱 실행: s26dex run --no-desktop <exe>" ;;
    none) ok "X 서버만 실행" ;;
    *) die "--shell 은 desktop|openbox|none" ;;
  esac
}

resolve_profile() { # 이름 또는 파일 경로 -> 파일
  local name="$1"
  if [ -f "$name" ]; then echo "$name"
  elif [ -f "$S26_CONF_DIR/profiles/$name.env" ]; then echo "$S26_CONF_DIR/profiles/$name.env"
  elif [ -f "$S26_ROOT/profiles/$name.env" ]; then echo "$S26_ROOT/profiles/$name.env"
  else die "프로필 없음: $name (compat|balanced|performance|extreme)"; fi
}

cmd_run() {
  local profile="$S26_DEFAULT_PROFILE" emu32="" cores="" fps="" d3d="" gl="" hud=0 mango=0
  local desktop="${S26_RUN_DESKTOP:-1}" log=0 dry=0 mode="" label=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --label) label="$2"; shift ;;
      --dex) mode=dex ;;
      --desktop) mode=desktop ;;
      -p|--profile) profile="$2"; shift ;;
      --emu32) emu32="$2"; shift ;;
      --cores) cores="$2"; shift ;;
      --fps) fps="$2"; shift ;;
      --d3d) d3d="$2"; shift ;;
      --gl) gl="$2"; shift ;;
      --hud) hud=1 ;;
      --mangohud) mango=1 ;;
      --no-desktop) desktop=0 ;;
      --log) log=1 ;;
      --dry-run) dry=1 ;;
      --) shift; break ;;
      -*) die "run: 알 수 없는 옵션 $1" ;;
      *) break ;;
    esac; shift
  done
  [ $# -ge 1 ] || die "실행할 파일을 지정하세요: s26dex run game.exe"
  local target="$1"; shift
  # C:\... 경로는 메인 프리픽스의 실제 파일로 바꿔서 아키텍처 판별·DXVK·작업 폴더를 적용
  if [[ "$target" =~ ^[Cc]:[\\/] ]]; then
    local unixp="$S26_WINEPREFIX/drive_c/${target:3}"
    unixp="${unixp//\\//}"
    [ -e "$unixp" ] && target="$unixp"
  fi
  if [ -e "$target" ]; then
    target="$(readlink -f "$target")"
  elif [[ ! "$target" =~ ^[A-Za-z]:[\\/] ]]; then
    die "파일 없음: $target"
  fi
  local arch; arch="$(pe_arch "$target")"
  local base="${target##*/}"
  # 설치 프로그램은 메인 프리픽스(Wine 데스크톱)에서 실행해야 레지스트리가 모든 앱에 공유됨
  if [ -z "$mode" ]; then
    case "${base,,}" in
      *.msi|*setup*|*install*) mode=desktop ;;
      *) mode="${S26_MODE:-dex}" ;;
    esac
  fi
  [ "$mode" = dex ] && desktop=0

  [ "$dry" = 1 ] || require_termux
  mkdirs; load_device; wine_base_env

  # 프로필 -> 앱별 설정(~/.config/sma26dex/apps/<exe>.env) -> 명령행 옵션 순으로 적용
  local pf; pf="$(resolve_profile "$profile")" || exit 1
  set -a
  # shellcheck disable=SC1090
  . "$pf"
  # shellcheck disable=SC1090
  [ -f "$S26_CONF_DIR/apps/$base.env" ] && . "$S26_CONF_DIR/apps/$base.env"
  set +a

  export HODLL64="${HODLL64:-libarm64ecfex.dll}"
  case "${emu32:-${S26_EMU32:-box64}}" in
    box64) export HODLL=wowbox64.dll ;;
    fex)   export HODLL=libwow64fex.dll ;;
    *) die "--emu32 는 box64|fex" ;;
  esac

  # Direct3D: x86/x64 앱에만 DXVK(x64/x32 DLL) 적용. ARM64 네이티브 앱은 Wine 내장 사용.
  local d="${d3d:-${S26_D3D:-dxvk}}"
  local ov="${WINEDLLOVERRIDES:-}"
  if [ "$d" = dxvk ]; then
    case "$arch" in
      x86|x86_64|arm64ec)
        if [ "$dry" = 1 ] || dxvk_deployed; then
          ov="${ov:+$ov;}d3d8,d3d9,d3d10core,d3d11,dxgi=n,b"
          { [ "$dry" = 1 ] || vkd3d_deployed; } && ov="$ov;d3d12,d3d12core=n,b"
        else
          warn "DXVK 미적용 상태 — 's26dex dxvk install' 실행 권장 (지금은 wined3d 사용)"
        fi ;;
    esac
  fi
  [ -n "$ov" ] && export WINEDLLOVERRIDES="$ov"

  case "${gl:-${S26_GL:-zink}}" in
    zink) export MESA_LOADER_DRIVER_OVERRIDE=zink GALLIUM_DRIVER=zink ;;
    llvmpipe) export GALLIUM_DRIVER=llvmpipe LIBGL_ALWAYS_SOFTWARE=1 ;;
    *) die "--gl 은 zink|llvmpipe" ;;
  esac
  [ -n "$fps" ] && export DXVK_FRAME_RATE="$fps"
  [ "$hud" = 1 ] && export DXVK_HUD="devinfo,fps,frametimes,gpuload,compiler"
  [ "$mango" = 1 ] && export MANGOHUD=1

  local cpus; case "${cores:-${S26_CPUS:-all}}" in
    all) cpus="${S26_CPUS_ALL:-}" ;;
    big) cpus="${S26_CPUS_BIG:-}" ;;
    prime) cpus="${S26_CPUS_PRIME:-}" ;;
    *) cpus="${cores:-$S26_CPUS}" ;;
  esac

  local cmd=()
  [ -n "$cpus" ] && have taskset && cmd+=(taskset -c "$cpus")
  cmd+=("$(wine_bin)")
  # 데스크톱 크기는 X 서버를 띄운 뒤에 정함 (먼저 계산하면 빈 값 → Wine 기본 800x600)
  [ "$desktop" = 1 ] && cmd+=(explorer "@DESKTOP@")
  case "${target,,}" in
    *.msi) cmd+=(msiexec /i "$target") ;;
    *.bat|*.cmd) cmd+=(cmd /c "$target") ;;
    *.lnk) cmd+=(start /unix "$target") ;;
    *) cmd+=("$target") ;;
  esac
  cmd+=("$@")

  local note=""
  case "$arch" in
    arm64) note="ARM64 네이티브 — 에뮬레이션 없음" ;;
    x86_64) note="x64 → FEX(ARM64EC)" ;;
    x86) note="x86 → ${HODLL%.dll}" ;;
  esac
  info "앱: $base [$arch${note:+, $note}]  모드: $( [ "$mode" = dex ] && echo "DeX 창 (컨테이너 $(slugify "$target"))" || echo "Wine 데스크톱")"
  info "프로필: ${pf##*/}  코어: ${cpus:-제한없음}  D3D: $d  GL: ${GALLIUM_DRIVER:-기본}  GPU: ${S26_VK_DEVICE:-?}"

  if [ "$dry" = 1 ]; then
    cmd=("${cmd[@]/#@DESKTOP@//desktop=$S26_DESKTOP_NAME,1920x1080}")
    env | grep -E '^(FEX_|BOX64_|HODLL|WINE|DXVK_|VKD3D|MESA_|GALLIUM|VK_|TU_|vblank|MANGOHUD|LIBGL)' | sort
    printf '명령:'; printf ' %q' "${cmd[@]}"; echo
    return 0
  fi

  # 백그라운드 cpuset 경고 (Termux 가 화면 밖으로 취급되면 저전력 코어로 묶임)
  local allowed; allowed="$(proc_allowed)"
  if [ -n "$allowed" ] && [ -n "${S26_CPUS_ALL:-}" ] && [ "$allowed" != "$S26_CPUS_ALL" ]; then
    warn "현재 Termux 프로세스 허용 코어: $allowed (전체: $S26_CPUS_ALL, cpuset: $(proc_cpuset))"
    warn "→ Termux:X11 sharedUid APK 설치 필요 (docs/ANDROID-SETUP.md §2). 지금은 일부 코어만 사용됩니다."
  fi

  if [ -d "$(dirname "$target")" ]; then cd "$(dirname "$target")" || true; fi

  if [ "$mode" = dex ]; then
    local slug; slug="$(slugify "$target")"
    # DeX 창 이름/아이콘: --label(바로가기 이름) 또는 exe 이름, 아이콘은 exe 에서 1회 추출
    export S26_DEX_LABEL="${label:-${base%.*}}"
    mkdir -p "$(container_dir "$slug")"
    [ -s "$(container_dir "$slug")/icon.png" ] || extract_icon "$target" "$(container_dir "$slug")/icon.png" 128 || true
    [ "$log" = 1 ] && export WINEDEBUG="err+all,fixme-all"
    if [ "$log" = 1 ]; then
      local dl; dl="$S26_LOG_DIR/${base%.*}-$(date +%Y%m%d-%H%M%S).log"
      info "로그: $dl"
      dex_launch "$slug" "${cmd[@]}" > >(tee "$dl") 2>&1
    else
      dex_launch "$slug" "${cmd[@]}"
    fi
    return
  fi

  x11_running || cmd_start
  ensure_prefix
  local size; size="$(x11_size)"
  cmd=("${cmd[@]/#@DESKTOP@//desktop=$S26_DESKTOP_NAME,${size:-1920x1080}}")

  if [ "$log" = 1 ]; then
    local lf; lf="$S26_LOG_DIR/${base%.*}-$(date +%Y%m%d-%H%M%S).log"
    export WINEDEBUG="err+all,fixme-all"
    info "로그: $lf"
    "${cmd[@]}" 2>&1 | tee "$lf"
  else
    "${cmd[@]}"
  fi
}

cmd_info() {
  [ $# -ge 1 ] || die "사용법: s26dex info <exe>"
  local a; a="$(pe_arch "$1")"
  echo "$1: $a"
  case "$a" in
    arm64) echo "  → 네이티브 실행. 가장 빠름." ;;
    x86_64) echo "  → FEX ARM64EC 에뮬레이션. Wine/시스템 호출과 그래픽 드라이버는 네이티브." ;;
    x86) echo "  → 32비트: wowbox64(기본) 또는 --emu32 fex." ;;
    arm64ec) echo "  → ARM64EC: 네이티브 + x64 플러그인 혼용 가능." ;;
  esac
}

cmd_dxvk() {
  case "${1:-install}" in
    install) require_termux; mkdirs; dxvk_download; dxvk_deploy ;;
    deploy)  require_termux; dxvk_deploy ;;
    status)
      dxvk_deployed && ok "DXVK 적용됨 ($(sys32))" || warn "DXVK 미적용"
      vkd3d_deployed && ok "VKD3D-Proton 적용됨" || warn "VKD3D-Proton 미적용" ;;
    *) die "s26dex dxvk install|deploy|status" ;;
  esac
}

cmd_doctor() {
  require_termux; mkdirs
  local all bad=0
  echo "== 기기"
  echo "  모델: $(getprop ro.product.model)  Android $(getprop ro.build.version.release) (SDK $(getprop ro.build.version.sdk))"
  echo "  SoC : $(getprop ro.soc.manufacturer) $(getprop ro.soc.model)  /  GPU 계열: $(gpu_family)"
  echo "  코어: $(cpu_freq_table | awk '{printf "%s:%dMHz ", $1, $2/1000}')"

  echo "== 패키지"
  local c
  for c in termux-x11 termux-x11-preference hangover-wine vulkaninfo pulseaudio taskset zstd xrandr \
           openbox wmctrl xprop xwininfo wrestool icotool fc-list; do
    if have "$c"; then ok "$c"; else warn "$c 없음 — ./install.sh 재실행"; bad=1; fi
  done
  [ -x "$(wine_bin)" ] && ok "Hangover: $("$(wine_bin)" --version 2>/dev/null)" || { warn "Hangover Wine 없음"; bad=1; }
  /system/bin/pm path com.termux.x11 >/dev/null 2>&1 && ok "Termux:X11 앱 설치됨" || { warn "Termux:X11 앱 미설치"; bad=1; }

  echo "== Vulkan (DXVK/zink 의 전제)"
  detect_device | sed 's/^/  /'
  load_device
  case "${S26_VK_API:-}" in
    1.[3-9]*|[2-9]*) ok "Vulkan $S26_VK_API — DXVK 2.x/3.x 사용 가능" ;;
    "") warn "Vulkan API 버전 확인 불가"; bad=1 ;;
    *) warn "Vulkan $S26_VK_API (<1.3) — DXVK_VERSION=1.10.3 으로 낮춰 설치 권장"; bad=1 ;;
  esac

  echo "== Termux:X11 패치판(sharedUid) 설치 조건"
  local rel t_uid x_uid
  # Termux 0.119+ 는 TERMUX_APP__APK_RELEASE, 0.118 은 TERMUX_APK_RELEASE
  rel="${TERMUX_APP__APK_RELEASE:-${TERMUX_APK_RELEASE:-알 수 없음}}"
  case "${rel,,}" in github*) rel=Github ;; esac
  t_uid="$(/system/bin/pm list packages -U 2>/dev/null | sed -n 's/^package:com\.termux uid:\([0-9]*\).*/\1/p')"
  x_uid="$(/system/bin/pm list packages -U 2>/dev/null | sed -n 's/^package:com\.termux\.x11 uid:\([0-9]*\).*/\1/p')"
  echo "  Termux 배포판: $rel   UID: Termux=${t_uid:-?} Termux:X11=${x_uid:-미설치}"
  if [ "$rel" != Github ] && [ "$rel" != "알 수 없음" ]; then
    warn "Termux 가 '$rel' 판 → sharedUid 판 설치 불가(서명 다름). GitHub판 Termux 로 바꾸거나 standalone 패치판 사용"; bad=1
  elif [ -z "$x_uid" ]; then
    ok "Termux:X11 미설치 → sharedUid 패치판 바로 설치 가능"
  elif [ "$x_uid" = "$t_uid" ]; then
    ok "Termux:X11 이 이미 sharedUid 판 → 패치판을 업데이트로 설치 가능"
  else
    warn "지금 Termux:X11 은 일반판(UID 다름) → Android 가 sharedUid 판으로의 업데이트를 막음 → Termux:X11 삭제 후 설치"; bad=1
  fi

  echo "== CPU 스케줄링 (가장 흔한 성능 저하 원인)"
  all="${S26_CPUS_ALL:-}"
  echo "  이 셸의 cpuset: $(proc_cpuset)   허용 코어: $(proc_allowed)   (전체 $all)"
  if [ "$(proc_allowed)" != "$all" ]; then
    warn "Termux 가 일부 코어로 제한됨 → Termux:X11 sharedUid APK + GitHub판 Termux 사용 (docs/ANDROID-SETUP.md)"
    bad=1
  else
    ok "모든 코어 사용 가능"
  fi

  echo "== Android 설정"
  local ph; ph="$(/system/bin/settings get global settings_enable_monitor_phantom_procs 2>/dev/null)"
  case "$ph" in
    false) ok "팬텀 프로세스 킬러 꺼짐" ;;
    true|null|"") warn "팬텀 프로세스 킬러 상태: ${ph:-확인불가} → 개발자 옵션 '하위 프로세스 제한 사용 중지' 켜기" ;;
  esac
  if grep -Eq '^[[:space:]]*allow-external-apps[[:space:]]*=[[:space:]]*true' "$HOME/.termux/termux.properties" 2>/dev/null; then
    ok "allow-external-apps = true (내 파일에서 exe/msi 열기 가능)"
  else
    warn "allow-external-apps 꺼짐 → 내 파일에서 exe/msi 열기 불가 (./install.sh 재실행)"
  fi
  [ -r /dev/kvm ] && echo "  /dev/kvm 접근 가능 (VM 가속 가능)" || echo "  /dev/kvm 접근 불가 → Windows VM(QEMU)은 순수 에뮬레이션이라 비추천"

  echo "== 저장공간"
  df -h "$HOME" 2>/dev/null | tail -1 | awk '{print "  남은 공간: "$4}'

  echo "== Wine"
  [ -f "$S26_WINEPREFIX/system.reg" ] && ok "프리픽스: $S26_WINEPREFIX" || warn "프리픽스 없음 (s26dex start 시 생성)"
  dxvk_deployed && ok "DXVK 적용됨" || warn "DXVK 미적용 → s26dex dxvk install"
  [ "$bad" = 0 ] && ok "점검 완료: 문제 없음" || warn "위 경고 항목을 먼저 해결하세요."
}

cmd_status() {
  local pid
  printf '%-7s %-6s %-8s %-14s %-12s %s\n' PID CPU% RSS_MB CPUSET 허용코어 명령
  for pid in $(pgrep -f 'wine|\.exe|termux-x11' 2>/dev/null); do
    [ -r "/proc/$pid/status" ] || continue
    printf '%-7s %-6s %-8s %-14s %-12s %s\n' "$pid" \
      "$(ps -o pcpu= -p "$pid" 2>/dev/null | tr -d ' ')" \
      "$(( $(awk '/VmRSS/{print $2}' "/proc/$pid/status" 2>/dev/null || echo 0) / 1024 ))" \
      "$(proc_cpuset "$pid")" "$(proc_allowed "$pid")" \
      "$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | cut -c1-70)"
  done
}

cmd_dpi() {
  [[ "${1:-}" =~ ^[0-9]+$ ]] || die "사용법: s26dex dpi 120   (96=100%, 120=125%, 144=150%, 192=200%)"
  load_device; wine_base_env
  wine_reg 'HKCU\Control Panel\Desktop' /v LogPixels /t REG_DWORD /d "$1" && ok "DPI=$1 (Wine 재시작 후 적용: s26dex kill)"
}

cmd_wine() { load_device; wine_base_env; ensure_prefix; exec "$(wine_bin)" "$@"; }

# 앱 지정: 바로가기 이름 / exe 경로 / 컨테이너 id
resolve_app() {
  local a="$1" sc="$HOME/.shortcuts/tasks/$1.sh" exe
  if [ -f "$sc" ]; then
    exe="$(sed -n 's/^# s26dex-exe: //p' "$sc")"
    [ -n "$exe" ] && { slugify "$exe"; return; }
  fi
  if [ -e "$a" ]; then slugify "$(readlink -f "$a")"; else echo "$a"; fi
}


cmd_app() {
  local sub="${1:-ls}"; shift 2>/dev/null || true
  local dir="$HOME/.shortcuts/tasks" icons="$HOME/.shortcuts/icons"
  case "$sub" in
    add)
      [ $# -ge 2 ] || die "사용법: s26dex app add <이름> [run옵션] <exe>"
      local name="$1"; shift
      local a args=() exe=""
      for a in "$@"; do
        [ -e "$a" ] && a="$(readlink -f "$a")"
        args+=("$a")
        case "${a,,}" in *.exe|*.msi|*.bat|*.cmd|*.lnk) exe="$a" ;; esac
      done
      [ -n "$exe" ] || die "exe 경로를 찾지 못했습니다."
      mkdir -p "$dir" "$icons"; chmod 700 "$HOME/.shortcuts" "$icons" 2>/dev/null
      local f="$dir/$name.sh"
      { echo "#!$PREFIX/bin/bash"
        echo "# s26dex-exe: $exe"
        printf 'exec %q run --label %q' "$PREFIX/bin/s26dex" "$name"; printf ' %q' "${args[@]}"; echo
      } > "$f"
      chmod 700 "$f"
      ok "바로가기: $f"
      if extract_icon "$exe" "$icons/$name.sh.png"; then
        chmod 600 "$icons/$name.sh.png"; ok "아이콘: $icons/$name.sh.png"
      else
        warn "exe 에서 아이콘을 추출하지 못했습니다 (pkg install icoutils)."
      fi
      echo "  → 홈/DeX 화면 길게 누르기 > 위젯 > Termux:Widget 에서 '$name' 을 추가하면 아이콘으로 실행됩니다." ;;
    ls)
      local f n e
      printf '%-20s %-6s %-8s %s
' 이름 아이콘 상태 exe
      for f in "$dir"/*.sh; do
        [ -f "$f" ] || continue
        e="$(sed -n 's/^# s26dex-exe: //p' "$f")"; [ -n "$e" ] || continue
        n="$(basename "$f" .sh)"
        printf '%-20s %-6s %-8s %s
' "$n" "$( [ -f "$icons/$n.sh.png" ] && echo 있음 || echo -)" \
          "$(dex_is_running "$(slugify "$e")" && echo 실행중 || echo -)" "$e"
      done ;;
    rm)
      [ -n "${1:-}" ] || die "사용법: s26dex app rm <이름>"
      rm -f "$dir/$1.sh" "$icons/$1.sh.png" && ok "삭제: $1 (앱 컨테이너는 유지 — 완전 삭제: rm -rf $S26_CONTAINERS/<id>)" ;;
    reset)
      [ -n "${1:-}" ] || die "사용법: s26dex app reset <이름|exe>"
      local slug; slug="$(resolve_app "$1")"
      dex_is_running "$slug" && die "$slug 실행 중 — 먼저 s26dex close $slug"
      [ -d "$(container_prefix "$slug")" ] || die "컨테이너 없음: $slug"
      container_copy_registry "$slug" && ok "$slug: 메인 프리픽스의 레지스트리로 다시 맞춤" ;;
    *) die "s26dex app add|ls|rm|reset" ;;
  esac
}

# 파일 관리자(내 파일 등)에서 연 Windows 프로그램 — 패치판 Termux:X11 이 RUN_COMMAND 로 호출
# 설치 프로그램(.msi, *setup*, *install*)은 Wine 데스크톱에서, 나머지는 DeX 창으로 실행
cmd_open() {
  [ $# -ge 1 ] || die "사용법: s26dex open <파일>"
  mkdirs
  local lf; lf="$S26_LOG_DIR/open-$(date +%Y%m%d-%H%M%S).log"
  {
    echo "== s26dex open $*"
    have termux-wake-lock && termux-wake-lock
    cmd_run "$@"
  } >>"$lf" 2>&1
}

# Vulkan 드라이버 진단 — 결과를 ~/s26dex-vkdebug.txt 에도 저장
cmd_vkdebug() {
  require_termux
  local out="$HOME/s26dex-vkdebug.txt" icd
  # shellcheck disable=SC2012  # 사람이 읽는 목록 출력
  {
    echo "== 기기: $(getprop ro.product.model) Android $(getprop ro.build.version.release) / $(getprop ro.soc.model) / vulkan=$(getprop ro.hardware.vulkan) egl=$(getprop ro.hardware.egl)"
    echo "== 패키지"
    dpkg -l 2>/dev/null | awk '/vulkan|mesa|wrapper|adrenotools/{print "  " $2 " " $3}'
    echo "== ICD 파일 ($(icd_dir))"
    ls -l "$(icd_dir)" 2>&1 | sed 's/^/  /'
    echo "== 시스템 Vulkan"
    ls -l /system/lib64/libvulkan.so /vendor/lib64/hw/vulkan.*.so 2>&1 | sed 's/^/  /'
    for icd in "$(icd_dir)"/*.json; do
      [ -e "$icd" ] || continue
      echo "== vulkaninfo --summary  [${icd##*/}]"
      VK_ICD_FILENAMES="$icd" VK_DRIVER_FILES="$icd" VK_LOADER_DEBUG=error,warn \
        timeout 30 vulkaninfo --summary 2>&1 | head -45 | sed 's/^/  /'
      echo "  (종료 코드 ${PIPESTATUS[0]})"
    done
    echo "== vulkaninfo --summary  [ICD 지정 없음]"
    VK_LOADER_DEBUG=error,warn timeout 30 vulkaninfo --summary 2>&1 | head -30 | sed 's/^/  /'
    echo "  (종료 코드 ${PIPESTATUS[0]})"
  } 2>&1 | tee "$out"
  echo
  ok "저장: $out"
}

cmd_fonts() {
  load_device
  local c
  ( wine_base_env; apply_korean_fonts ) && ok "메인 프리픽스 글꼴 대체 적용"
  for c in "$S26_CONTAINERS"/*/prefix; do
    [ -f "$c/system.reg" ] || continue
    dex_is_running "$(basename "$(dirname "$c")")" && { warn "실행 중이라 건너뜀: $c"; continue; }
    ( wine_base_env; export WINEPREFIX="$c"; apply_korean_fonts; "$(wineserver_bin)" -k 2>/dev/null ) && ok "적용: $c"
  done
}

cmd_locale() {
  case "${1:-status}" in
    ko|ko_KR|ko_KR.UTF-8)
      require_termux
      have clang || { info "clang 설치 (심 빌드용, 1회)"; pkg install -y clang || die "clang 설치 실패"; }
      mkdir -p "$(dirname "$S26_LOCALE_LIB")"
      clang -shared -fPIC -O2 -o "$S26_LOCALE_LIB" "$S26_ROOT/lib/s26locale.c" -ldl || die "심 빌드 실패"
      config_set S26_LOCALE ko_KR.UTF-8
      ok "한국어 로캘 켜짐 (코드페이지 949). 실행 중인 Wine 은 s26dex kill 후 적용됩니다." ;;
    off) config_set S26_LOCALE "" && ok "한국어 로캘 꺼짐" ;;
    status) echo "S26_LOCALE=${S26_LOCALE:-(없음)}  심: $( [ -f "$S26_LOCALE_LIB" ] && echo "$S26_LOCALE_LIB" || echo 없음)" ;;
    *) die "s26dex locale ko|off|status" ;;
  esac
}

cmd_dex_each() { # 실행 중인 DeX 앱마다 함수 실행
  local d slug
  for d in "$S26_CONTAINERS"/*/; do
    [ -d "$d" ] || continue
    slug="$(basename "$d")"
    dex_is_running "$slug" && "$@" "$slug"
  done
}

dex_kill_one() { WINEPREFIX="$(container_prefix "$1")" "$(wineserver_bin)" -k 2>/dev/null; }

cmd_kill() {
  load_device; wine_base_env
  "$(wineserver_bin)" -k 2>/dev/null
  cmd_dex_each dex_kill_one
  ok "Wine 종료"
}

cmd_stop() {
  cmd_kill
  am broadcast -a com.termux.x11.ACTION_STOP -p com.termux.x11 >/dev/null 2>&1
  pkill -f 'termux-x11' 2>/dev/null
  pulseaudio --kill >/dev/null 2>&1
  have termux-wake-unlock && termux-wake-unlock >/dev/null 2>&1
  ok "모두 종료"
}

main() {
  local c="${1:-help}"; shift 2>/dev/null || true
  case "$c" in
    start) cmd_start "$@" ;;
    run) cmd_run "$@" ;;
    info) cmd_info "$@" ;;
    dxvk) cmd_dxvk "$@" ;;
    detect) cmd_detect ;;
    doctor) cmd_doctor ;;
    status) cmd_status ;;
    dpi) cmd_dpi "$@" ;;
    cfg) cmd_wine winecfg ;;
    wine) cmd_wine "$@" ;;
    app) cmd_app "$@" ;;
    shortcut) cmd_app add "$@" ;;
    ps) dex_list ;;
    show) [ -n "${1:-}" ] || die "사용법: s26dex show <앱>"; dex_show "$(resolve_app "$1")" || die "실행 중이 아님: $1" ;;
    close)
      if [ "${1:-}" = --force ]; then shift; [ -n "${1:-}" ] || die "사용법: s26dex close [--force] <앱>"; dex_close "$(resolve_app "$1")" force
      else [ -n "${1:-}" ] || die "사용법: s26dex close [--force] <앱>"; dex_close "$(resolve_app "$1")"; fi ;;
    fonts) cmd_fonts ;;
    open) cmd_open "$@" ;;
    vkdebug) cmd_vkdebug ;;
    locale) cmd_locale "$@" ;;
    kill) cmd_kill ;;
    stop) cmd_stop ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
  esac
}
main "$@"
