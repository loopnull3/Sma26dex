# compat — 호환성 최우선. 크래시·그래픽 깨짐이 날 때 먼저 시도.
# FEX (x86-64 앱, ARM64EC)
FEX_TSOENABLED=1
FEX_VECTORTSOENABLED=1
FEX_MEMCPYSETTSOENABLED=1
FEX_HALFBARRIERTSOENABLED=1
FEX_X87REDUCEDPRECISION=0
FEX_MULTIBLOCK=1
FEX_SMCCHECKS=mtrack
# Box64 (32비트 x86 앱, wowbox64)
BOX64_DYNAREC_STRONGMEM=1
BOX64_DYNAREC_BIGBLOCK=0
BOX64_DYNAREC_CALLRET=0
BOX64_DYNAREC_SAFEFLAGS=2
BOX64_DYNAREC_FASTNAN=0
BOX64_DYNAREC_FASTROUND=0
BOX64_DYNAREC_X87DOUBLE=1
# 그래픽
MESA_VK_WSI_PRESENT_MODE=fifo
S26_GL=llvmpipe
S26_CPUS=all
